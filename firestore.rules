rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAdmin() {
      return request.auth != null && request.auth.token.email == 'markdavid104@gmail.com';
    }
    function allowlistPath() {
      return /databases/$(database)/documents/allowlist/$(request.auth.token.email);
    }
    function isApproved() {
      return request.auth != null &&
        exists(allowlistPath()) &&
        get(allowlistPath()).data.canView == true;
    }
    function isApprover() {
      return isAdmin() ||
        (isApproved() && get(allowlistPath()).data.isApprover == true);
    }

    match /people/{personId} {
      allow read: if isAdmin() || isApproved();
      allow write: if isApprover();
    }

    match /pendingChanges/{changeId} {
      allow read: if isAdmin() || isApproved();
      allow create: if isAdmin() || isApproved();
      allow update, delete: if isApprover();
    }

    match /allowlist/{email} {
      allow read: if isAdmin() || isApproved();
      allow write: if isAdmin() || isApprover();
    }

    match /meta/{doc} {
      allow read: if isAdmin() || isApproved();
      allow write: if isApprover();
    }
  }
}
